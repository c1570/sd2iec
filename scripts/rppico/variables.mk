# architecture-dependent variables

#---------------- Pico SDK ----------------
# SDK platform for each supported CONFIG_MCU
PICO_PLATFORM_rp2350 := rp2350-arm-s

PICO_PLATFORM := $(PICO_PLATFORM_$(CONFIG_MCU))
PICO_BOARD    := $(CONFIG_PICO_BOARD)
PICO_BUILDDIR := $(OBJDIR)/pico
PICO_FLAGS_MK := $(OBJDIR)/pico-flags.mk

# compiler flags of the SDK, generated by the cmake configure step
ifneq ($(MAKECMDGOALS),clean)
  include $(PICO_FLAGS_MK)
endif

#---------------- Source code ----------------
SRC += rppico/iec-bus.c rppico/crc.c rppico/arch-eeprom.c rppico/rp-glue.c
ifdef NEED_I2C
  SRC += rppico/i2c.c
endif

SRC += rppico/llfl-common.c llfl/llfl-jiffydos.c

# low-level loader code, only where enabled: some files define
# handlers that otherwise come from generic code
ifeq ($(CONFIG_LOADER_TURBODISK),y)
  SRC += llfl/llfl-turbodisk.c
endif
ifeq ($(CONFIG_LOADER_FC3),y)
  SRC += llfl/llfl-fc3exos.c
endif
ifeq ($(CONFIG_LOADER_AR6),y)
  SRC += llfl/llfl-ar6.c
endif
ifeq ($(CONFIG_LOADER_DREAMLOAD),y)
  SRC += llfl/llfl-dreamload.c
endif
ifeq ($(CONFIG_LOADER_ULOAD3),y)
  SRC += llfl/llfl-ulm3.c
endif
ifeq ($(CONFIG_LOADER_EPYXCART),y)
  SRC += llfl/llfl-epyxcart.c
endif
ifeq ($(CONFIG_LOADER_GEOS),y)
  SRC += llfl/llfl-geos.c
endif
ifeq ($(CONFIG_LOADER_N0SDOS),y)
  SRC += llfl/llfl-n0sdos.c
endif

#---------------- Toolchain ----------------
CC = arm-none-eabi-gcc
AR = arm-none-eabi-ar
OBJCOPY = arm-none-eabi-objcopy
OBJDUMP = arm-none-eabi-objdump
SIZE = arm-none-eabi-size
NM = arm-none-eabi-nm


#---------------- Architecture variables ----------------
# The SDK headers need C11
CSTANDARD = -std=gnu11

ARCH_CFLAGS  = $(PICO_ARCH_FLAGS) $(PICO_INCLUDES) $(PICO_DEFINES) -Isrc/llfl
ARCH_ASFLAGS = $(PICO_ARCH_FLAGS) $(PICO_INCLUDES) $(PICO_DEFINES)
ARCH_LDFLAGS =
